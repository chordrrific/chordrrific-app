{
	"name": "chordrrific",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"effect": "3.22.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest run src",
		"test:integration": "node scripts/test-integration.mjs",
		"test": "npm run test:unit && npm run test:integration",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:generate": "svelte-kit sync && prisma generate",
		"db:migrate": "node scripts/ensure-db.mjs && prisma migrate dev",
		"db:deploy": "node scripts/ensure-db.mjs && prisma migrate deploy",
		"db:seed": "node --import tsx prisma/seed.ts",
		"db:studio": "prisma studio"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^20",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prisma": "^7.10.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"argon2": "^0.45.2",
		"chordsheetjs": "^18.0.0",
		"dotenv": "^18.0.10"
	}
}
