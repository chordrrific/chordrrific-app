		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^20",
		"autoprefixer": "^10.5.4",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
